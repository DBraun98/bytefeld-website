---
import kunde from '../data/kunde.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const jahr = new Date().getFullYear();
---
<footer class="fuss">
  <div class="rahmen leiste">
    <span>© {jahr} {kunde.firma.name}</span>
    <ul>
      <li><a href={`${base}/impressum/`}>Impressum</a></li>
      <li><a href={`${base}/datenschutz/`}>Datenschutz</a></li>
    </ul>
  </div>
</footer>

<style>
  .fuss {
    background: var(--farbe-boden);
    color: #C9D2CD;
    font-size: .95rem;
  }
  .leiste {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem;
  }
  ul { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  a { color: #C9D2CD; }
</style>
